FROM python:3.12-slim

WORKDIR /verify

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements.txt .
COPY requirements.verify.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements.verify.txt

COPY app /app/app
ENV PYTHONPATH=/app

CMD ["python", "-m", "pytest", "-v", "/verify"]
